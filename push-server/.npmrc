# Supply-chain hardening (see README "Dependencies").
# Refuse to install under an unsupported Node version (package.json engines).
engine-strict=true
# No dependency lifecycle scripts: wrangler's esbuild and workerd ship their
# binaries as optional platform packages, so nothing needs install scripts.
ignore-scripts=true
# Install exactly what package-lock.json pins.
save-exact=true
audit-level=moderate
